{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlashManager",
  "version": "0.1.0",
  "identifier": "com.char.flashmanager",
  "build": {
    "beforeDevCommand": ".\\node_modules\\.bin\\vite.cmd",
    "beforeBuildCommand": ".\\node_modules\\.bin\\vite.cmd build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "守饭人",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
